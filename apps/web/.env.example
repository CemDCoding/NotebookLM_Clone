# Copy to apps/web/.env.local and fill in. Never commit the real file.
# Only public values belong here: no service role keys, no AI provider keys.

# --- Supabase (login only) ------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Anon / publishable key of the Supabase project
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- API ------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Legal notice and privacy policy (server-only, no NEXT_PUBLIC_ prefix) --
# Operator details shown on /impressum and /datenschutz. Kept out of the repository
# on purpose. Optional locally; a Vercel production build fails if one is missing.
IMPRESSUM_NAME=
IMPRESSUM_STREET=
# Postal code and city, e.g. "12345 Musterstadt"
IMPRESSUM_CITY=
IMPRESSUM_EMAIL=

# --- E2E tests (Playwright, development environment only) -----------------
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
