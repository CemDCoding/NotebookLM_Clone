# Copy to apps/web/.env.local and fill in. Never commit the real file.
# Only public values belong here: no service role keys, no AI provider keys.

# --- Supabase (login only) ------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Anon / publishable key of the Supabase project
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- API ------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- E2E tests (Playwright, development environment only) -----------------
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
