# Copy to apps/api/.env and fill in. Never commit the real .env file.
# Validated at startup by src/config/env.schema.ts: the API refuses to start if a
# required variable is missing. Empty values count as unset, so defaults apply.

# --- Server ---------------------------------------------------------------
# Optional, default 4000. Railway sets it automatically.
PORT=4000
# Optional, default all. all = HTTP API + ingestion worker | api = HTTP only | worker = ingestion only
RUN_MODE=all
# Required. Only this origin may call the API (CORS). Exact origin, no path or trailing slash.
WEB_ORIGIN=http://localhost:3000

# --- Supabase -------------------------------------------------------------
# Required. Session pooler connection string (port 5432, NOT the transaction pooler on 6543)
DATABASE_URL=
# Required. Project URL, used for JWKS and Storage.
SUPABASE_URL=
# Required. Server-side only. Grants full access to storage and auth admin.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers ---------------------------------------------------------
# Required. Used for chat and embeddings.
MISTRAL_API_KEY=
# Optional. Allowed chat models for the picker. The first one is the default (cheapest).
CHAT_MODELS=mistral-small-latest,ministral-8b-latest
# Optional, local development only. Enables Ollama models in the picker.
OLLAMA_BASE_URL=
OLLAMA_CHAT_MODELS=

# --- Limits (optional, defaults for the public demo, CLAUDE.md section 7) --
MAX_FILE_SIZE_MB=10
MAX_PDF_PAGES=300
MAX_PASTED_TEXT_CHARS=500000
MAX_SOURCES_PER_NOTEBOOK=20
MAX_NOTEBOOKS_PER_USER=25
CHAT_LIMIT_PER_USER_PER_HOUR=100
GLOBAL_CHAT_LIMIT_PER_DAY=500
GLOBAL_UPLOAD_LIMIT_PER_DAY=200

# --- Seed script ----------------------------------------------------------
# Demo account created by `pnpm --filter api db:seed`. Never commit real values.
# Read only by the seed script, not by the API.
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
