# Copy to apps/api/.env and fill in. Never commit the real .env file.

# --- Server ---------------------------------------------------------------
PORT=4000
# all = HTTP API + ingestion worker | api = HTTP only | worker = ingestion only
RUN_MODE=all
# Only this origin may call the API (CORS)
WEB_ORIGIN=http://localhost:3000

# --- Supabase -------------------------------------------------------------
# Session pooler connection string (port 5432, NOT the transaction pooler on 6543)
DATABASE_URL=
SUPABASE_URL=
# Server-side only. Grants full access to storage and auth admin.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers ---------------------------------------------------------
MISTRAL_API_KEY=
# Allowed chat models for the picker. The first one is the default (cheapest).
CHAT_MODELS=mistral-small-latest,ministral-8b-latest
# Optional, local development only. Enables Ollama models in the picker.
OLLAMA_BASE_URL=
OLLAMA_CHAT_MODELS=

# --- Limits (defaults for the public demo) --------------------------------
MAX_FILE_SIZE_MB=10
MAX_PDF_PAGES=300
MAX_PASTED_TEXT_CHARS=500000
MAX_SOURCES_PER_NOTEBOOK=20
MAX_NOTEBOOKS_PER_USER=25
CHAT_LIMIT_PER_USER_PER_HOUR=100
GLOBAL_CHAT_LIMIT_PER_DAY=500
GLOBAL_UPLOAD_LIMIT_PER_DAY=200

# --- Seed script ----------------------------------------------------------
# Demo account created by `pnpm --filter api db:seed`. Never commit real values.
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
