{
  "name": "notebooklm-clone",
  "private": true,
  "description": "NotebookLM clone: chat with your own documents, with verifiable citations, GDPR-compliant in the EU.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --stream dev",
    "build": "pnpm -r build",
    "lint": "pnpm --filter @notebooklm/shared build && pnpm -r lint",
    "typecheck": "pnpm --filter @notebooklm/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @notebooklm/shared build && pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "pnpm --filter web test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.14.0"
}
